module Blake3ruby
  VERSION: String
end

module Digest
  module Blake3
    def self.hexdigest: (String subject) -> String
    def self.derive_key: (String context, String key) -> String

    class Hasher
      def self.new: () -> Digest::Blake3::Hasher
      def update: (String subject) -> Digest::Blake3::Hasher
      def finalize: () -> String
    end
  end
end
